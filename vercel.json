{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/warm",
      "schedule": "0 2 * * *"
    }
  ],
  "functions": {
    "api/predict.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "lib/foresight/**"
    }
  }
}
